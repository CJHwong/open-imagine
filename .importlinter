[importlinter]
root_package = studio
include_external_packages = True

[importlinter:contract:layers]
name = Clean architecture layers
type = layers
layers =
    studio.l4_frameworks_and_drivers
    studio.l3_interface_adapters
    studio.l2_use_cases
    studio.l1_entities

[importlinter:contract:gateways-isolation]
name = Gateways do not depend on controllers or presenters
type = forbidden
source_modules =
    studio.l3_interface_adapters.gateways
forbidden_modules =
    studio.l3_interface_adapters.controllers
    studio.l3_interface_adapters.presenters
    studio.l3_interface_adapters.api


[importlinter:contract:presenters-isolation]
name = Presenters do not depend on controllers or gateways
type = forbidden
source_modules =
    studio.l3_interface_adapters.presenters
forbidden_modules =
    studio.l3_interface_adapters.controllers
    studio.l3_interface_adapters.gateways
    studio.l3_interface_adapters.api


[importlinter:contract:controllers-isolation]
name = Controllers do not depend on gateways or presenters
type = forbidden
source_modules =
    studio.l3_interface_adapters.controllers
forbidden_modules =
    studio.l3_interface_adapters.gateways
    studio.l3_interface_adapters.presenters
    studio.l3_interface_adapters.api


[importlinter:contract:no-engines-in-core]
name = The core touches no engine, image library, HTTP or process
type = forbidden
source_modules =
    studio.l1_entities
    studio.l2_use_cases
forbidden_modules =
    mlx
    mflux
    torch
    diffusers
    PIL
    http
    subprocess

[importlinter:contract:backends-independent]
name = Each backend adapter stands alone; shared helpers sit next to them
type = independence
modules =
    studio.l3_interface_adapters.gateways.image.qwen21
    studio.l3_interface_adapters.gateways.image.qwen21_turbo
    studio.l3_interface_adapters.gateways.image.flux2
    studio.l3_interface_adapters.gateways.image.flux3
    studio.l3_interface_adapters.gateways.image.krea2
    studio.l3_interface_adapters.gateways.image.viggle_turbo
    studio.l3_interface_adapters.gateways.image.qwen_checkpoint
    studio.l3_interface_adapters.gateways.video.gemma3
    studio.l3_interface_adapters.gateways.video.ltx25
    studio.l3_interface_adapters.gateways.video.ltx23
    studio.l3_interface_adapters.gateways.video.ltx_pack
    studio.l3_interface_adapters.gateways.voice.auk
    studio.l3_interface_adapters.gateways.voice.auk_flash
    studio.l3_interface_adapters.gateways.voice.drama3
    studio.l3_interface_adapters.gateways.music.yue2

[importlinter:contract:api-isolation]
name = JSON adapters depend on ports rather than concrete storage or engines
type = forbidden
source_modules =
    studio.l3_interface_adapters.api
forbidden_modules =
    studio.l3_interface_adapters.gateways


[importlinter:contract:drivers-composition-only]
name = Framework drivers leave model adapters to the composition root
type = forbidden
source_modules =
    studio.l4_frameworks_and_drivers.http_server
    studio.l4_frameworks_and_drivers.config
    studio.l4_frameworks_and_drivers.engines
    studio.l4_frameworks_and_drivers.subprocess_runner
forbidden_modules =
    studio.l3_interface_adapters.gateways

[importlinter:contract:plugin-sdk-inner-only]
name = The public model plugin SDK exposes inner contracts, not concrete adapters or drivers
type = forbidden
source_modules =
    studio.plugins
forbidden_modules =
    studio.l3_interface_adapters
    studio.l4_frameworks_and_drivers

[importlinter:contract:registration-discovery-isolation]
name = Installed model discovery does not construct gateways or runtimes
type = forbidden
source_modules =
    studio.l4_frameworks_and_drivers.model_registration.installed_model_catalog
forbidden_modules =
    studio.l3_interface_adapters.gateways
    studio.l4_frameworks_and_drivers.model_registration.model_backend_factory
    studio.l4_frameworks_and_drivers.model_factories
    studio.l4_frameworks_and_drivers.subprocess_runner

[importlinter:contract:memory-catalog-model-independence]
name = The memory catalog selects injected estimators rather than importing models
type = forbidden
source_modules =
    studio.l3_interface_adapters.gateways.memory
forbidden_modules =
    studio.l3_interface_adapters.gateways.image
    studio.l3_interface_adapters.gateways.video
    studio.l3_interface_adapters.gateways.voice
    studio.l3_interface_adapters.gateways.music
